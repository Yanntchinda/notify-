{
  "name": "transit-app",
  "version": "1.0.0",
  "private": true,
  "description": "Application de transit Ro-Ro — cotation en ligne, couloirs maritimes, distance jusqu’au port et espace administrateur",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node -e \"require('./server/seed').resetAndSeed(); console.log('Base de démonstration réinitialisée')\"",
    "backup": "node scripts/backup.js",
    "test:api": "node scripts/api-test.js",
    "test:e2e": "node scripts/e2e-ui.js",
    "test": "node scripts/api-test.js",
    "build:android": "node scripts/build-mobile.js android",
    "build:ios": "node scripts/build-mobile.js ios",
    "build:seed-sql": "node scripts/build-supabase-seed.js",
    "test:supabase": "node scripts/test-supabase.js",
    "build:demo-content": "node scripts/build-demo-content.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/ios": "^6.2.3",
    "@supabase/supabase-js": "^2.119.2",
    "jsdom": "^31.0.1"
  }
}
