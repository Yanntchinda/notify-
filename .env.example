# Port du serveur
PORT=3000

# URL publique de l'application (utilisée dans les e-mails de réinitialisation)
APP_URL=https://transit.example.com

# E-mails sortants (facultatif : sans SMTP, les e-mails sont simulés dans les logs)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=utilisateur
# SMTP_PASS=mot-de-passe
# SMTP_FROM=Transit <no-reply@transit.example.com>

# Alerte e-mail à chaque nouvelle demande (facultatif)
# ADMIN_EMAIL=admin@transit.example.com
