{
  "name": "wacrm-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype de contacts locaux sans Docker",
  "main": "src/local-main.cjs",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "test:e2e": "node test-e2e/contacts.cjs"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.1"
  },
  "build": {
    "appId": "com.wacrm.localdesktop",
    "productName": "wacrm Local Prototype",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
