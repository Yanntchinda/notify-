{
  "name": "wacrm-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental Windows shell for a local wacrm installation",
  "main": "src/main.cjs",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.wacrm.localdesktop",
    "productName": "wacrm Local (experimental)",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
